<UserControl
    x:Class="FileOp.App.FilesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FileOp.App">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="6">
            <TextBlock Text="Files" FontSize="28" FontWeight="SemiBold" />
            <TextBlock x:Name="ScopeText"
                       Text="Indexed directory browsing becomes available when the shared search source is ready."
                       Opacity="0.7"
                       TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="1" Margin="0,14,0,0" Padding="12,10"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="8">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button x:Name="PrepareLeftToRightButton"
                        Content="Prepare Left → Right"
                        Click="PrepareLeftToRightButton_Click"
                        IsEnabled="False"
                        ToolTipService.ToolTip="Capture the selected Left entries and current Right folder as an operation intent" />
                <Button x:Name="PrepareRightToLeftButton"
                        Grid.Column="1"
                        Content="Prepare Right → Left"
                        Click="PrepareRightToLeftButton_Click"
                        IsEnabled="False"
                        ToolTipService.ToolTip="Capture the selected Right entries and current Left folder as an operation intent" />

                <TextBlock x:Name="IntentText"
                           Grid.Column="2"
                           Text="Select one or more entries in a source pane, then prepare a direction. Queueing is planning only; no file operation is executed."
                           Opacity="0.68"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center" />

                <StackPanel Grid.Column="3" Spacing="4">
                    <TextBlock Text="On collision" FontSize="12" Opacity="0.65" />
                    <ComboBox x:Name="CollisionPolicyBox"
                              Width="142"
                              SelectionChanged="CollisionPolicyBox_SelectionChanged">
                        <ComboBoxItem Content="Ask later" Tag="Ask" />
                        <ComboBoxItem Content="Skip existing" Tag="Skip" />
                        <ComboBoxItem Content="Stop on collision" Tag="Stop" />
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" VerticalAlignment="Bottom">
                    <Button x:Name="QueueCopyButton" Content="Queue Copy"
                            Click="QueueCopyButton_Click" IsEnabled="False"
                            ToolTipService.ToolTip="Add an immutable copy plan to the in-memory queue; nothing is executed" />
                    <Button x:Name="QueueMoveButton" Content="Queue Move"
                            Click="QueueMoveButton_Click" IsEnabled="False"
                            ToolTipService.ToolTip="Add an immutable move plan to the in-memory queue; nothing is executed" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Margin="0,10,0,0" Padding="12,10"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="8">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Planned operation queue" FontWeight="SemiBold" />
                    <TextBlock x:Name="QueueCountText" Grid.Column="1" Opacity="0.65" VerticalAlignment="Center" />
                    <Button x:Name="PreflightQueuedOperationButton" Grid.Column="2" Content="Preflight selected"
                            Click="PreflightQueuedOperationButton_Click" IsEnabled="False"
                            ToolTipService.ToolTip="Read current path metadata for the selected plan; this does not execute or authorize file changes" />
                    <Button x:Name="RemoveQueuedOperationButton" Grid.Column="3" Content="Remove selected"
                            Click="RemoveQueuedOperationButton_Click" IsEnabled="False" />
                    <Button x:Name="ClearQueueButton" Grid.Column="4" Content="Clear queue"
                            Click="ClearQueueButton_Click" IsEnabled="False" />
                </Grid>

                <TextBlock x:Name="QueueStatusText" Grid.Row="1"
                           Text="Plans are session-only. Preflight reads live metadata only; execution remains disabled."
                           Opacity="0.65" TextWrapping="Wrap" />

                <ListView x:Name="OperationQueueList" Grid.Row="2" MaxHeight="128"
                          SelectionMode="Single"
                          SelectionChanged="OperationQueueList_SelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="6,4" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="120" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding OperationText}" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="{Binding RouteText}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2" Text="{Binding CollisionText}" Opacity="0.7" />
                                <TextBlock Grid.Column="3" Text="{Binding PreflightText}" Opacity="0.72" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="4" Text="{Binding QueuedText}" Opacity="0.62" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <Border Grid.Row="3" Margin="0,10,0,0" Padding="12,10"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="8">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button x:Name="ReviewDeleteLeftButton"
                        Content="Review Left deletion…"
                        Click="ReviewDeleteLeftButton_Click"
                        IsEnabled="False"
                        ToolTipService.ToolTip="Run read-only delete checks for the exact Left file selection, then require explicit confirmation before any destructive authorization" />
                <Button x:Name="ReviewDeleteRightButton"
                        Grid.Column="1"
                        Content="Review Right deletion…"
                        Click="ReviewDeleteRightButton_Click"
                        IsEnabled="False"
                        ToolTipService.ToolTip="Run read-only delete checks for the exact Right file selection, then require explicit confirmation before any destructive authorization" />

                <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="Permanent file deletion" FontWeight="SemiBold" />
                    <TextBlock x:Name="DeleteStatusText"
                               Text="Select files in exactly one ready pane to review deletion. Directories, Recycle Bin, undo and automatic recovery replay are not supported."
                               Opacity="0.68"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="4" Margin="0,12,0,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <local:FilesPaneView x:Name="LeftPaneControl" PaneTitle="Left" />
            <local:FilesPaneView x:Name="RightPaneControl" Grid.Column="1" PaneTitle="Right" />
        </Grid>
    </Grid>
</UserControl>
