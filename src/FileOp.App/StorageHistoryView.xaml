<UserControl
    x:Class="FileOp.App.StorageHistoryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid ColumnSpacing="14" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.15*" />
            <ColumnDefinition Width="0.85*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.ColumnSpan="2"
                Padding="14"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <StackPanel Spacing="10">
                <StackPanel Spacing="3">
                    <TextBlock Text="Current free space vs latest history" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock
                        Text="Current volume capacity is compared only with the latest two native aggregate observations. Physical free space is never compared with logical-size growth, and FileOp does not project a disk-full date from sparse history."
                        Opacity="0.68"
                        TextWrapping="Wrap" />
                </StackPanel>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="3">
                        <TextBlock Text="Current free" Opacity="0.62" />
                        <TextBlock x:Name="PressureFreeText" Text="—" FontSize="18" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="3">
                        <TextBlock Text="Latest indexed storage" Opacity="0.62" />
                        <TextBlock x:Name="PressureLatestText" Text="—" FontSize="18" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="3">
                        <TextBlock Text="Last observed change" Opacity="0.62" />
                        <TextBlock x:Name="PressureDeltaText" Text="—" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="3" Spacing="3">
                        <TextBlock Text="Free space / last growth" Opacity="0.62" />
                        <TextBlock x:Name="PressureMultipleText" Text="—" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
                <TextBlock x:Name="PressureStatusText"
                           Text="Load native history to compare current free space with trustworthy aggregate observations."
                           Opacity="0.7"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Grid.Column="0"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="12,10"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="3">
                            <TextBlock Text="Usage timeline" FontWeight="SemiBold" />
                            <TextBlock x:Name="HistoryStatusText"
                                       Text="Native history has not been loaded yet."
                                       Opacity="0.6"
                                       FontSize="11"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <ProgressRing x:Name="HistoryProgressRing" Width="16" Height="16" IsActive="False" />
                            <Button x:Name="RefreshButton" Content="Refresh history" Click="RefreshButton_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <ListView x:Name="TimelineList" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="9,7" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="95" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding BucketText}" VerticalAlignment="Center" Opacity="0.75" />
                                    <ProgressBar Grid.Column="1"
                                                 Value="{Binding PercentOfPeak}"
                                                 Maximum="100"
                                                 Height="7"
                                                 VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding SizeText}"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3"
                                               Text="{Binding DeltaText}"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               Opacity="0.7" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="TimelineEmptyText"
                               Text="No native history observations yet."
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Opacity="0.6"
                               Visibility="Collapsed" />
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="12,10"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1">
                    <StackPanel Spacing="3">
                        <TextBlock Text="What grew?" FontWeight="SemiBold" />
                        <TextBlock x:Name="GrowthStatusText"
                                   Text="Two observations are needed to calculate a change."
                                   Opacity="0.6"
                                   FontSize="11"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Grid Grid.Row="1">
                    <ListView x:Name="GrowthList" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="9,7" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="105" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding DetailText}" FontSize="11" Opacity="0.58" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding DeltaText}"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="GrowthEmptyText"
                               Text="No category change to show."
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Opacity="0.6"
                               Visibility="Collapsed" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
