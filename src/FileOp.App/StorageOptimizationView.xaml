<UserControl
    x:Class="FileOp.App.StorageOptimizationView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FileOp.App">
    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Text="Optimization advisor" FontSize="20" FontWeight="SemiBold" />
                <TextBlock
                    Text="Read-only storage and performance evidence. Same-size groups are candidates, not confirmed duplicates, until you explicitly verify sampled file contents."
                    TextWrapping="Wrap"
                    Opacity="0.72" />
            </StackPanel>
            <Button
                x:Name="RefreshButton"
                Grid.Column="1"
                Content="Refresh"
                VerticalAlignment="Top"
                Click="RefreshButton_Click" />
        </Grid>

        <TextBlock
            x:Name="StatusText"
            Grid.Row="1"
            Text="Optimization analysis has not been loaded yet."
            TextWrapping="Wrap"
            Opacity="0.8" />

        <ScrollViewer Grid.Row="2">
            <StackPanel Spacing="24" Padding="0,0,12,12">
                <local:PerformanceDiagnosticsView x:Name="PerformanceDiagnostics" />
                <local:FileOpResourceFootprintView x:Name="FileOpResourceFootprint" />

                <StackPanel Spacing="8">
                    <TextBlock Text="Largest files" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock
                        Text="Ranked by physical allocation when known, otherwise logical size."
                        TextWrapping="Wrap"
                        Opacity="0.7" />
                    <ListView x:Name="LargestFilesList" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="0,6" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Path}" Opacity="0.65" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding SizeText}" HorizontalAlignment="Right" />
                                        <TextBlock Text="{Binding LastWriteText}" Opacity="0.65" HorizontalAlignment="Right" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Text="Old large files to review" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock
                        Text="Age is based only on last-write metadata. FileOp does not infer that an old file is safe to remove."
                        TextWrapping="Wrap"
                        Opacity="0.7" />
                    <ListView x:Name="StaleFilesList" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="0,6" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Path}" Opacity="0.65" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding SizeText}" HorizontalAlignment="Right" />
                                        <TextBlock Text="{Binding LastWriteText}" Opacity="0.65" HorizontalAlignment="Right" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Text="Same-size duplicate candidates" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock
                        Text="Hard-link aliases are collapsed by the index first. Potential savings are a logical upper bound only until content is verified. Verify content fully SHA-256 hashes a bounded sample under your user account, then revalidates current physical identity, hard-link count, and allocated disk bytes for hash matches. Any physical reclaim value is a current upper bound for sampled matches, not deletion authorization."
                        TextWrapping="Wrap"
                        Opacity="0.7" />
                    <ListView x:Name="SameSizeGroupsList" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="0,8" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{Binding Heading}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding SampleText}" Opacity="0.65" TextWrapping="Wrap" MaxWidth="760" />
                                        <TextBlock Text="{Binding VerificationText}" Opacity="0.78" TextWrapping="Wrap" MaxWidth="760" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" Spacing="6">
                                        <TextBlock Text="{Binding PotentialText}" HorizontalAlignment="Right" />
                                        <TextBlock Text="candidate upper bound" Opacity="0.65" HorizontalAlignment="Right" />
                                        <Button
                                            Content="Verify content"
                                            IsEnabled="{Binding CanVerify}"
                                            HorizontalAlignment="Right"
                                            Click="VerifySameSizeContentButton_Click" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
