<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>FileOp.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;arm64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <IndexerTargetFramework>net10.0-windows10.0.17763.0</IndexerTargetFramework>
    <IndexerOutputDirectory>$(MSBuildProjectDirectory)\..\FileOp.Indexer\bin\$(Platform)\$(Configuration)\$(IndexerTargetFramework)</IndexerOutputDirectory>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.3.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FileOp.Core\FileOp.Core.csproj" />
    <ProjectReference Include="..\FileOp.Windows\FileOp.Windows.csproj" />
    <ProjectReference Include="..\FileOp.Indexer\FileOp.Indexer.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="CopyIndexerHost" AfterTargets="Build">
    <ItemGroup>
      <IndexerHostFiles Include="$(IndexerOutputDirectory)\FileOp.Indexer.exe" />
      <IndexerHostFiles Include="$(IndexerOutputDirectory)\FileOp.Indexer.dll" />
      <IndexerHostFiles Include="$(IndexerOutputDirectory)\FileOp.Indexer.deps.json" />
      <IndexerHostFiles Include="$(IndexerOutputDirectory)\FileOp.Indexer.runtimeconfig.json" />
    </ItemGroup>

    <Error Condition="!Exists('$(IndexerOutputDirectory)\FileOp.Indexer.exe')"
           Text="FileOp.Indexer.exe was not produced before the desktop app copy step." />
    <Copy SourceFiles="@(IndexerHostFiles)"
          DestinationFolder="$(TargetDir)"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
