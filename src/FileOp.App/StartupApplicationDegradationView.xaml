<UserControl
    x:Class="FileOp.App.StartupApplicationDegradationView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Padding="14,10" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="3">
                    <TextBlock Text="Historical startup degradation events" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock
                        Text="Explicit bounded read of retained Windows Diagnostics-Performance Event 101 compatibility telemetry. This is not a startup-registration census, complete boot history, impact score or recommendation to disable an application."
                        Opacity="0.68"
                        TextWrapping="Wrap" />
                </StackPanel>
                <Button x:Name="CaptureButton"
                        Grid.Column="1"
                        Content="Read startup degradation history"
                        Click="CaptureButton_Click" />
            </Grid>

            <TextBlock x:Name="StatusText"
                       Grid.Row="1"
                       Padding="14,10"
                       Text="Startup degradation compatibility history has not been read yet."
                       Opacity="0.78"
                       TextWrapping="Wrap" />

            <Grid Grid.Row="2" Padding="14,8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,1" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.5*" />
                    <ColumnDefinition Width="1.05*" />
                    <ColumnDefinition Width="1.05*" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="100" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Windows component" FontWeight="SemiBold" />
                <TextBlock Grid.Column="1" Text="Event recorded" FontWeight="SemiBold" />
                <TextBlock Grid.Column="2" Text="Incident / start" FontWeight="SemiBold" />
                <TextBlock Grid.Column="3" Text="Total time" FontWeight="SemiBold" HorizontalAlignment="Right" />
                <TextBlock Grid.Column="4" Text="Degradation time" FontWeight="SemiBold" HorizontalAlignment="Right" />
                <TextBlock Grid.Column="5" Text="Event" FontWeight="SemiBold" HorizontalAlignment="Right" />
            </Grid>

            <ListView x:Name="RowsList" Grid.Row="3" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="12,8" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.5*" />
                                <ColumnDefinition Width="1.05*" />
                                <ColumnDefinition Width="1.05*" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="100" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding ComponentText}" TextWrapping="Wrap" />
                            <TextBlock Grid.Column="1" Text="{Binding RecordedText}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2" Text="{Binding IncidentText}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="3" Text="{Binding TotalTimeText}" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="4" Text="{Binding DegradationTimeText}" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="5" Text="{Binding EventText}" HorizontalAlignment="Right" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Border>
</UserControl>
