<UserControl
    x:Class="FileOp.App.DiskIoAttributionView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Padding="14,12" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="3">
                    <TextBlock Text="Disk I/O attribution" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock
                        Text="Explicit 2-second ETW capture. FileOp reports observed disk/process traffic, attribution coverage, response timing and trace loss; it does not continuously monitor or treat this as a health score."
                        Opacity="0.68"
                        TextWrapping="Wrap" />
                </StackPanel>
                <Button
                    x:Name="CaptureButton"
                    Grid.Column="1"
                    Content="Capture disk I/O"
                    Click="CaptureButton_Click" />
            </Grid>

            <TextBlock
                x:Name="StatusText"
                Grid.Row="1"
                Padding="14,10"
                Text="No Disk I/O attribution capture has been run."
                Opacity="0.78"
                TextWrapping="Wrap" />

            <Grid Grid.Row="2" Padding="14,6,14,12" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="3">
                    <TextBlock Text="Stop reason" Opacity="0.62" />
                    <TextBlock x:Name="StopReasonText" Text="—" FontSize="18" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="3">
                    <TextBlock Text="Accepted events" Opacity="0.62" />
                    <TextBlock x:Name="AcceptedEventsText" Text="—" FontSize="18" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="3">
                    <TextBlock Text="ETW loss" Opacity="0.62" />
                    <TextBlock x:Name="LossText" Text="—" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="3" Spacing="3">
                    <TextBlock Text="Observed window" Opacity="0.62" />
                    <TextBlock x:Name="DurationText" Text="—" FontSize="18" FontWeight="SemiBold" />
                </StackPanel>
            </Grid>

            <TextBlock Grid.Row="3" Padding="14,8,14,5" Text="Physical disks" FontSize="16" FontWeight="SemiBold" />
            <Grid Grid.Row="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Padding="14,8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,1" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Disk" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="Read" FontWeight="SemiBold" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="2" Text="Write" FontWeight="SemiBold" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="3" Text="Operations" FontWeight="SemiBold" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="4" Text="Attributed" FontWeight="SemiBold" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="5" Text="Unattributed / hidden" FontWeight="SemiBold" Margin="14,0,0,0" />
                </Grid>
                <ListView x:Name="DiskList" Grid.Row="1" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="14,8" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding DiskText}" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="{Binding ReadText}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="2" Text="{Binding WriteText}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="3" Text="{Binding OperationsText}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="4" Text="{Binding AttributionText}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="5" Text="{Binding UnattributedText}" Margin="14,0,0,0" Opacity="0.72" TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <StackPanel Grid.Row="5" Padding="14,10,14,5" Spacing="3">
                <TextBlock Text="Response timing by physical disk" FontSize="16" FontWeight="SemiBold" />
                <TextBlock
                    Text="Completion-response evidence only. These durations are not a queue-time/service-time decomposition and do not by themselves establish a storage bottleneck. p95 is shown only with at least 5 samples for that operation."
                    Opacity="0.62"
                    TextWrapping="Wrap" />
            </StackPanel>
            <Grid Grid.Row="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Padding="14,8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,1" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Disk" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="Read response" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="2" Text="Write response" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="3" Text="Flush response" FontWeight="SemiBold" />
                </Grid>
                <ListView x:Name="TimingList" Grid.Row="1" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="14,8" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding DiskText}" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="{Binding ReadTimingText}" TextWrapping="Wrap" />
                                <TextBlock Grid.Column="2" Text="{Binding WriteTimingText}" TextWrapping="Wrap" />
                                <TextBlock Grid.Column="3" Text="{Binding FlushTimingText}" TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <TextBlock Grid.Row="7" Padding="14,10,14,5" Text="Top attributed process instances" FontSize="16" FontWeight="SemiBold" />
            <Grid Grid.Row="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Padding="14,8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="110" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Disk" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="Process instance" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="2" Text="Read" FontWeight="SemiBold" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="3" Text="Write" FontWeight="SemiBold" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="4" Text="Operations" FontWeight="SemiBold" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="5" Text="Byte share" FontWeight="SemiBold" HorizontalAlignment="Right" />
                </Grid>
                <ListView x:Name="ProcessList" Grid.Row="1" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="14,8" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="110" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding DiskText}" />
                                <TextBlock Grid.Column="1" Text="{Binding ProcessInstanceText}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Grid.Column="2" Text="{Binding ReadText}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="3" Text="{Binding WriteText}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="4" Text="{Binding OperationsText}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="5" Text="{Binding ShareText}" HorizontalAlignment="Right" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>
    </Border>
</UserControl>
