<UserControl
    x:Class="FileOp.App.StorageKnownLocationReviewView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="10">
        <TextBlock Text="Known locations review" FontSize="16" FontWeight="SemiBold" />
        <TextBlock
            Text="Read-only, bounded review evidence from the current native index. Downloads/Temp location, file age, size, or extension do not establish that a file is safe to delete. Review in Files only opens the indexed browser; cleanup readiness only revalidates current path evidence. Neither action prepares, queues, authorizes, or executes deletion."
            TextWrapping="Wrap"
            Opacity="0.72" />
        <TextBlock
            x:Name="StatusText"
            Text="Known-location review has not been loaded yet."
            TextWrapping="Wrap"
            Opacity="0.82" />
        <TextBlock
            x:Name="CleanupReadinessStatusText"
            Text="Cleanup readiness has not been checked. Delete recovery/history and mutation authorization are not implemented."
            TextWrapping="Wrap"
            Opacity="0.76" />

        <ListView x:Name="LocationStatusList" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Padding="0,5" Spacing="2">
                        <TextBlock Text="{Binding Heading}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Opacity="0.68" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <ListView x:Name="CandidateList" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="0,7" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" Opacity="0.64" />
                            <TextBlock Text="{Binding EvidenceText}" TextWrapping="Wrap" Opacity="0.74" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" Spacing="6">
                            <TextBlock Text="{Binding SizeText}" HorizontalAlignment="Right" />
                            <TextBlock Text="{Binding LastWriteText}" HorizontalAlignment="Right" Opacity="0.64" />
                            <Button
                                Content="Check readiness"
                                HorizontalAlignment="Right"
                                Click="CheckCleanupReadinessButton_Click" />
                            <Button
                                Content="Review in Files"
                                HorizontalAlignment="Right"
                                Click="ReviewInFilesButton_Click" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </StackPanel>
</UserControl>
