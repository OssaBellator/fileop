<UserControl
    x:Class="FileOp.App.PerformanceDiagnosticsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FileOp.App">
    <Grid RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="5">
                <TextBlock Text="Performance" FontSize="28" FontWeight="SemiBold" />
                <TextBlock
                    Text="Measured diagnostics only. Refresh runs bounded foreground probes; FileOp does not continuously poll, clean the registry, free RAM, or disable services."
                    Opacity="0.72"
                    TextWrapping="Wrap" />
            </StackPanel>
            <Button
                x:Name="RefreshButton"
                Grid.Column="1"
                Content="Refresh diagnostics"
                Click="RefreshButton_Click" />
        </Grid>

        <TextBlock
            x:Name="StatusText"
            Grid.Row="1"
            Text="Diagnostics have not been captured yet."
            Opacity="0.8"
            TextWrapping="Wrap" />

        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Padding="14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                <StackPanel Spacing="4">
                    <TextBlock Text="Source" Opacity="0.65" />
                    <TextBlock x:Name="SourceText" Text="—" FontSize="20" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Padding="14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                <StackPanel Spacing="4">
                    <TextBlock Text="Indexed items" Opacity="0.65" />
                    <TextBlock x:Name="IndexedItemsText" Text="—" FontSize="20" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Padding="14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                <StackPanel Spacing="4">
                    <TextBlock Text="Free space" Opacity="0.65" />
                    <TextBlock x:Name="FreeSpaceText" Text="—" FontSize="20" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <Border Grid.Column="3" Padding="14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                <StackPanel Spacing="4">
                    <TextBlock Text="Captured" Opacity="0.65" />
                    <TextBlock x:Name="CapturedText" Text="—" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="3" Padding="14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
            <StackPanel Spacing="12">
                <StackPanel Spacing="3">
                    <TextBlock Text="FileOp index footprint" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock
                        Text="Helper-owned read-only SQLite evidence. Reusable pages are internal database free pages; the reader cache default is a connection setting, not observed RAM usage."
                        Opacity="0.68"
                        TextWrapping="Wrap" />
                </StackPanel>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="3">
                        <TextBlock Text="Helper files" Opacity="0.62" />
                        <TextBlock x:Name="IndexFootprintText" Text="—" FontSize="18" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="3">
                        <TextBlock Text="Main database" Opacity="0.62" />
                        <TextBlock x:Name="IndexDatabaseText" Text="—" FontSize="18" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="3">
                        <TextBlock Text="WAL" Opacity="0.62" />
                        <TextBlock x:Name="IndexWalText" Text="—" FontSize="18" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Grid.Column="3" Spacing="3">
                        <TextBlock Text="Reusable pages" Opacity="0.62" />
                        <TextBlock x:Name="IndexReusableText" Text="—" FontSize="18" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Grid.Column="4" Spacing="3">
                        <TextBlock Text="Reader cache default" Opacity="0.62" />
                        <TextBlock x:Name="IndexCacheText" Text="—" FontSize="18" FontWeight="SemiBold" />
                    </StackPanel>
                </Grid>
                <TextBlock x:Name="IndexStatusText"
                           Text="Native index database metrics have not been captured yet."
                           Opacity="0.7"
                           TextWrapping="Wrap" />

                <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                    <StackPanel Spacing="10">
                        <StackPanel Spacing="3">
                            <TextBlock Text="USN/checkpoint freshness" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock
                                Text="Durable checkpoint continuity compared with one live USN-journal metadata query. USN distances are sequence-position differences, not file/event counts, bytes, or elapsed time."
                                Opacity="0.68"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="3">
                                <TextBlock Text="Checkpoint age" Opacity="0.62" />
                                <TextBlock x:Name="CheckpointAgeText" Text="—" FontSize="18" FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="3">
                                <TextBlock Text="Journal identity" Opacity="0.62" />
                                <TextBlock x:Name="JournalIdentityText" Text="—" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="3">
                                <TextBlock Text="USN backlog distance" Opacity="0.62" />
                                <TextBlock x:Name="UsnBacklogText" Text="—" FontSize="18" FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel Grid.Column="3" Spacing="3">
                                <TextBlock Text="Retention headroom" Opacity="0.62" />
                                <TextBlock x:Name="RetentionHeadroomText" Text="—" FontSize="18" FontWeight="SemiBold" />
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="JournalStatusText"
                                   Text="Durable/live USN freshness evidence has not been captured yet."
                                   Opacity="0.7"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <Border Grid.Row="4" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Padding="14,10" Spacing="3" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                    <TextBlock Text="Session latency distribution" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock
                        Text="Last 20 explicit diagnostics samples per exact Search/Storage probe and source. A source/root change starts a fresh window; nearest-rank p95 is shown only after 5 samples. Nothing is sampled in the background or persisted."
                        Opacity="0.68"
                        TextWrapping="Wrap" />
                </StackPanel>
                <Grid Grid.Row="1" Padding="14,10" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="88" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="100" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Probe" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="Scope" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="2" Text="Samples" FontWeight="SemiBold" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="3" Text="Min" FontWeight="SemiBold" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="4" Text="Median" FontWeight="SemiBold" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="5" Text="p95 (5+)" FontWeight="SemiBold" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="6" Text="Max" FontWeight="SemiBold" HorizontalAlignment="Right" />
                </Grid>
                <ListView x:Name="LatencyDistributionList" Grid.Row="2" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="12,8" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="88" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="100" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Text="{Binding Scope}" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2" Text="{Binding SamplesText}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="3" Text="{Binding MinimumText}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="4" Text="{Binding MedianText}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="5" Text="{Binding P95Text}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="6" Text="{Binding MaximumText}" HorizontalAlignment="Right" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <Border Grid.Row="5" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Padding="14,10" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.3*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="2.5*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Probe" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="Scope" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="2" Text="Current elapsed" FontWeight="SemiBold" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="3" Text="Exact measurement" FontWeight="SemiBold" Margin="14,0,0,0" />
                </Grid>
                <ListView x:Name="ProbeList" Grid.Row="1" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="12,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.3*" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="2.5*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Text="{Binding Scope}" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2" Text="{Binding ElapsedText}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="3" Text="{Binding Detail}" Margin="14,0,0,0" Opacity="0.7" TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <local:MachineProcessActivityView
            x:Name="MachineProcessActivity"
            Grid.Row="6" />
    </Grid>
</UserControl>
