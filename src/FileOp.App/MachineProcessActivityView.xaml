<UserControl
    x:Class="FileOp.App.MachineProcessActivityView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Padding="14,10" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="3">
                    <TextBlock Text="Current machine process activity" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock
                        Text="Explicit bounded two-frame sample. Rows are stable PID + process-start identities ranked by measured CPU-time delta, then end working/private memory. Process start time is context only; FileOp does not classify foreground/background state or reconstruct boot impact."
                        Opacity="0.68"
                        TextWrapping="Wrap" />
                </StackPanel>
                <Button x:Name="CaptureButton"
                        Grid.Column="1"
                        Content="Capture machine activity"
                        Click="CaptureButton_Click" />
            </Grid>

            <TextBlock x:Name="StatusText"
                       Grid.Row="1"
                       Padding="14,10"
                       Text="Machine activity has not been captured yet."
                       Opacity="0.78"
                       TextWrapping="Wrap" />

            <Grid Grid.Row="2" Padding="14,6,14,10" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="Stable matched" Opacity="0.62" />
                    <TextBlock x:Name="MatchedText" Text="—" FontSize="17" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="Appeared / disappeared" Opacity="0.62" />
                    <TextBlock x:Name="TurnoverText" Text="—" FontSize="17" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="2">
                    <TextBlock Text="Hidden matched CPU Δ" Opacity="0.62" />
                    <TextBlock x:Name="HiddenCpuText" Text="—" FontSize="17" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Grid.Column="3" Spacing="2">
                    <TextBlock Text="FileOp observer" Opacity="0.62" />
                    <TextBlock x:Name="ObserverText" Text="—" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="3" Padding="14,8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,1" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.5*" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="78" />
                    <ColumnDefinition Width="1.2*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Stable process instance" FontWeight="SemiBold" />
                <TextBlock Grid.Column="1" Text="CPU-time Δ" FontWeight="SemiBold" HorizontalAlignment="Right" />
                <TextBlock Grid.Column="2" Text="Working set" FontWeight="SemiBold" HorizontalAlignment="Right" />
                <TextBlock Grid.Column="3" Text="Private" FontWeight="SemiBold" HorizontalAlignment="Right" />
                <TextBlock Grid.Column="4" Text="Threads" FontWeight="SemiBold" HorizontalAlignment="Right" />
                <TextBlock Grid.Column="5" Text="Process start" FontWeight="SemiBold" Margin="10,0,0,0" />
            </Grid>

            <ListView x:Name="RowsList" Grid.Row="4" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="12,8" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.5*" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="78" />
                                <ColumnDefinition Width="1.2*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding IdentityText}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="{Binding CpuDeltaText}" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="2" Text="{Binding WorkingSetText}" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="3" Text="{Binding PrivateMemoryText}" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="4" Text="{Binding ThreadCountText}" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="5" Text="{Binding StartedText}" Margin="10,0,0,0" TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Border>
</UserControl>
