<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <RootNamespace>FileOp.FilesystemSafety</RootNamespace>
    <AssemblyName>FileOp.FilesystemSafety</AssemblyName>
    <PackageId>FileOp.FilesystemSafety</PackageId>
    <VersionPrefix>1.0.0</VersionPrefix>
    <IsPackable>true</IsPackable>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/OssaBellator/fileop</RepositoryUrl>
    <Description>Read-only Windows filesystem identity, canonical-path, operation-safety and recovery evidence contracts for FileOp consumers.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Update="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
