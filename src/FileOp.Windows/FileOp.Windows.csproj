<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <RootNamespace>FileOp.Windows</RootNamespace>
  </PropertyGroup>

  <ItemGroup Condition="'$(FileOpTrustedIndexerSignerThumbprints)' != ''">
    <AssemblyMetadata Include="FileOpTrustedIndexerSignerThumbprints"
                      Value="$(FileOpTrustedIndexerSignerThumbprints)" />
  </ItemGroup>

  <Target Name="ValidateRequiredIndexerSignerPolicy"
          BeforeTargets="CoreCompile"
          Condition="'$(FileOpRequireTrustedIndexerSigner)' == 'true'">
    <Error Condition="'$(FileOpTrustedIndexerSignerThumbprints)' == ''"
           Text="Production helper trust requires FileOpTrustedIndexerSignerThumbprints (semicolon-separated SHA-1 certificate thumbprints)." />
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
    <PackageReference Include="System.Diagnostics.EventLog" Version="10.0.10" />
    <PackageReference Include="System.Management" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FileOp.Core\FileOp.Core.csproj" />
  </ItemGroup>
</Project>
